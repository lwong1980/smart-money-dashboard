# Copy this file to .streamlit/secrets.toml (which is gitignored) and fill it in.
#
# ── One-time Google Cloud setup ─────────────────────────────────────────────
# 1. https://console.cloud.google.com → pick/create a project.
# 2. APIs & Services → OAuth consent screen: configure it (User type "External"
#    is fine; while in "Testing" mode, add every allowed person under
#    "Test users" — anyone else is blocked by Google before they reach this app).
# 3. APIs & Services → Credentials → Create Credentials → OAuth client ID
#    → Application type: "Web application".
# 4. Under "Authorized redirect URIs" add EXACTLY (scheme, host, port and path
#    must all match — no trailing slash):
#
#        http://localhost:8501/oauth2callback
#
#    Google only accepts http:// for "localhost". If you serve the app from a
#    real domain, use https, e.g. https://dash.example.com/oauth2callback, and
#    put that same value in redirect_uri below. A raw LAN IP such as
#    http://192.168.1.5:8501/... is REJECTED by Google.
# 5. Copy the Client ID and Client secret into the fields below.
# 6. Generate cookie_secret (any long random string) with:
#        python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Also required in the environment (not in this file) before the FIRST login:
#        export BOOTSTRAP_ADMIN_EMAIL="you@gmail.com"   # the Google account that becomes admin
# ────────────────────────────────────────────────────────────────────────────

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_ME_with_a_long_random_string"
client_id = "REPLACE_ME.apps.googleusercontent.com"
client_secret = "REPLACE_ME"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
