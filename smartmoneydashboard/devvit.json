{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "smartmoneydashboard",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "externalEndpoints": {
      "sentiment": {
        "endpoint": "/external/sentiment",
        "scopes": ["global"]
      }
    }
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "[smartmoneydashboard] New Post",
        "description": "Create a new smartmoneydashboard post.",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
